{
  "buildCommand": "npm run build",
  "framework": "vite",
  "outputDirectory": "dist",
  "regions": ["sfo1"],
  "routes": [
    {
      "src": "/(?!.*\\.)",
      "dest": "/index.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "src": "/(?P<path>.*)",
      "dest": "/index.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    }
  ]
}
