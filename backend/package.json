{
  "name": "gov-schemes-analytics-backend",
  "version": "1.0.0",
  "description": "Central analytics backend for government schemes monitoring",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "prisma generate",
    "migrate": "prisma migrate deploy",
    "seed": "node src/migrations/seed.js",
    "sync:official": "node scripts/sync-official-data.js",
    "purge:synthetic": "node scripts/purge-synthetic-demo-data.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\""
  },
  "keywords": [
    "government-schemes",
    "analytics",
    "kpi",
    "dashboard",
    "predictions"
  ],
  "author": "Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.0",
    "prisma": "^5.1.1",
    "@prisma/client": "^5.1.1",
    "node-fetch": "^3.3.0",
    "morgan": "^1.10.0",
    "express-async-errors": "^3.1.1",
    "compression": "^1.7.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "eslint": "^8.45.0",
    "prettier": "^3.0.0",
    "@faker-js/faker": "^8.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
