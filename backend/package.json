{
  "name": "gov-schemes-analytics-backend",
  "version": "1.0.0",
  "description": "Central analytics backend for government schemes monitoring",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node src/migrations/migrate.js",
    "seed": "node src/migrations/seed.js",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\""
  },
  "keywords": [
    "government-schemes",
    "analytics",
    "kpi",
    "dashboard",
    "predictions"
  ],
  "author": "Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.0",
    "node-cron": "^3.0.3",
    "prisma": "^5.1.1",
    "@prisma/client": "^5.1.1",
    "pdfkit": "^0.13.0",
    "xlsx": "^0.18.5",
    "node-fetch": "^3.3.0",
    "redis": "^4.6.5",
    "morgan": "^1.10.0",
    "express-async-errors": "^3.1.1",
    "compression": "^1.7.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "eslint": "^8.45.0",
    "prettier": "^3.0.0",
    "@faker-js/faker": "^8.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
