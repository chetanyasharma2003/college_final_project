# Copy to backend/.env for local development. Never commit backend/.env.
NODE_ENV=development
PORT=5001
HOST=0.0.0.0
DATABASE_URL=postgresql://govschemes:replace-with-a-strong-local-password@localhost:5432/gov_schemes
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DATA_GOV_API_KEY=replace-with-a-valid-data-gov-in-api-key
PMAY_API_KEY=
MGNREGS_API_KEY=
PMGSY_API_KEY=
DDUGKY_API_KEY=
SAGY_API_KEY=
SEED_ADMIN_PASSWORD=
SEED_ANALYST_PASSWORD=
ALLOW_SYNTHETIC_SEED=false
