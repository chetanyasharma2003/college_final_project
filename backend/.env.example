# Copy to backend/.env for local development. Never commit backend/.env.
NODE_ENV=development
PORT=5001
HOST=0.0.0.0
DATABASE_URL=postgresql://govschemes:replace-with-a-strong-local-password@localhost:5432/gov_schemes
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Use one key per scheme. Never put API keys in *_SOURCE_URL.
# PMAY is the current combined project record; PMAY-G / PMAY-U keys are available
# for separate integrations, which require separate scheme records and mappings.
DATA_GOV_API_KEY_PMAY=
DATA_GOV_API_KEY_PMAY_G=
DATA_GOV_API_KEY_PMAY_U=
DATA_GOV_API_KEY_MGNREGS=
DATA_GOV_API_KEY_PMGSY=
DATA_GOV_API_KEY_NRLM=
DATA_GOV_API_KEY_DDU_GKY=
DATA_GOV_API_KEY_SAGY=
# Optional fallback for legacy single-key setups; per-scheme keys take precedence.
DATA_GOV_API_KEY=
# Set verified resource IDs and JSON field maps only after checking each dataset schema.
# Field map form: {"state":"source column","district":"source column","block":"optional source column","village":"optional source column","date":"source column","metrics":{"dataPointId":"source column"}}
DATA_GOV_RESOURCE_ID_PMAY=
DATA_GOV_FIELD_MAP_PMAY=
DATA_GOV_RESOURCE_ID_MGNREGS=
DATA_GOV_FIELD_MAP_MGNREGS=
DATA_GOV_RESOURCE_ID_PMGSY=
DATA_GOV_FIELD_MAP_PMGSY=
DATA_GOV_RESOURCE_ID_NRLM=
DATA_GOV_FIELD_MAP_NRLM=
DATA_GOV_RESOURCE_ID_DDU_GKY=
DATA_GOV_FIELD_MAP_DDU_GKY=
DATA_GOV_RESOURCE_ID_SAGY=
DATA_GOV_FIELD_MAP_SAGY=
SEED_ADMIN_PASSWORD=
SEED_ANALYST_PASSWORD=
ALLOW_SYNTHETIC_SEED=false
ENABLE_DATA_SYNC_SCHEDULER=false
