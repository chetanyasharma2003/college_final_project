{
  "name": "government-schemes-analytics",
  "version": "1.0.0",
  "description": "Source-attributed analytics dashboard for reported KPIs across six government scheme families",
  "scripts": {
    "health:check": "node scripts/health-check.js",
    "frontend:build": "cd frontend && npm run build",
    "frontend:test": "cd frontend && npm test",
    "frontend:dev": "cd frontend && npm run dev",
    "backend:dev": "cd backend && npm run dev",
    "dev": "concurrently \"npm run frontend:dev\" \"npm run backend:dev\"",
    "build": "npm run frontend:build",
    "test": "npm run frontend:build && npm run frontend:test && npm run backend:test",
    "backend:test": "cd backend && npm test"
  },
  "keywords": [
    "government",
    "analytics",
    "schemes",
    "kpi",
    "automation",
    "ci-cd"
  ],
  "author": "Government Schemes Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
