{
  "name": "government-schemes-analytics",
  "version": "1.0.0",
  "description": "Automated Government Schemes Real-time Analytics Dashboard",
  "scripts": {
    "auto:system": "node scripts/auto-system.js",
    "auto:deploy": "node scripts/auto-deploy.js",
    "auto:fix": "node scripts/auto-fix.js",
    "health:check": "node scripts/health-check.js",
    "frontend:build": "cd frontend && npm run build",
    "frontend:dev": "cd frontend && npm run dev",
    "backend:dev": "cd backend && npm run dev",
    "dev": "concurrently \"npm run frontend:dev\" \"npm run backend:dev\"",
    "build": "npm run frontend:build",
    "test": "npm run frontend:build && npm run auto:fix"
  },
  "keywords": [
    "government",
    "analytics",
    "schemes",
    "kpi",
    "automation",
    "ci-cd"
  ],
  "author": "Government Schemes Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
